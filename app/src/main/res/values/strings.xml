    <string name="app_name">Aster VPN</string>
    <string name="app_tagline">Private internet</string>

    <string name="onb_title_welcome">Private internet in one tap</string>
    <string name="onb_text_welcome">Aster VPN wraps all phone traffic into an encrypted tunnel. No sign-up and no accounts: keys are created on the device and never leave it.</string>
    <string name="onb_title_connect">1. Create a profile</string>
    <string name="onb_text_connect">On the main screen tap «Generate» — the profile is created automatically. Already have a .conf file? Tap «From file» instead.</string>
    <string name="onb_title_secure">2. Connect</string>
    <string name="onb_text_secure">Tap the big round button and allow the VPN in the system dialog. The app finds a working server by itself, so the first connection can take up to 30 seconds. When the circle turns green, you are protected.</string>
