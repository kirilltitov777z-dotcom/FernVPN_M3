    <string name="onb_title_welcome">Welcome to FernVPN</string>
    <string name="onb_text_welcome">A private internet for your phone. All traffic goes inside an encrypted tunnel — no accounts, no logs, keys never leave the device.</string>
    <string name="onb_title_connect">Generate or import</string>
    <string name="onb_text_connect">Tap «Generate» to create a profile automatically, or load a ready .conf file from your phone. Then press the big button and allow the VPN connection in the system dialog.</string>
    <string name="onb_title_secure">Stay protected</string>
    <string name="onb_text_secure">The app picks a working server by itself, so the first connection can take up to half a minute. If the network blocks the connection, try Wi-Fi or another profile.</string>
