    <string name="onb_title_welcome">Welcome to FernVPN</string>
    <string name="onb_text_welcome">A private internet through Cloudflare WARP. All traffic goes inside an encrypted WireGuard tunnel — no accounts, no logs, keys never leave your phone.</string>
    <string name="onb_title_connect">One tap</string>
    <string name="onb_text_connect">Tap the big button and allow the VPN connection in the system dialog. The app will pick a working WARP server and port itself, so the first connection can take up to half a minute.</string>
    <string name="onb_title_pet">A fern grows with you</string>
    <string name="onb_text_pet">While the tunnel is on, a small fern next to the button grows. Turn the VPN off and it pauses. You can hide it in settings at any time.</string>
